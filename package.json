{
  "name": "smart-inventory",
  "version": "1.0.0",
  "description": "Warehouse Management Application with real-time inventory tracking and role-based access control",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
