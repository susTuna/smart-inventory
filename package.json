    "swr": "^2.2.5",
    "axios": "^1.6.8",
    "date-fns": "^3.3.1",
    "recharts": "^2.10.3",
    "framer-motion": "^10.16.16"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
